---
import "@styles/global.css"
import Topmenubar from "@components/topmenubar.astro"

const { title = "Casyu.me — Notes on code & life", reading = false } = Astro.props
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title}</title>
    <meta
      name="description"
      content="Personal notes on code, ideas, and occasional thoughts by Casyu."
    />
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <Topmenubar />
    <main id="main" class:list={["site-main", { "site-main--reading": reading }]}>
      <slot />
    </main>
    <footer class="site-footer">
      <a href="/">Casyu.me</a>
      <span>A personal collection of notes.</span>
    </footer>
  </body>
</html>
