---
import Basic from "@layouts/basic.astro"
import Mdcomp from "@components/mdcomp.astro"

const { title, pubDate, topics, headings, archived, sourceUrl } = Astro.props
---

<Basic title={title} reading>
  <Mdcomp
    title={title}
    pubDate={pubDate}
    topics={topics}
    headings={headings}
    archived={archived}
    sourceUrl={sourceUrl}
  >
    <slot />
  </Mdcomp>
</Basic>
