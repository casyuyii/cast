---
const links = [
  {
    label: "About",
    href: "/about",
  },
]
---

<nav class="site-nav" aria-label="Main navigation">
  <div class="nav-inner">
    <a class="wordmark" href="/">Casyu<span class="wordmark-dot">.</span>me</a>
    <div class="nav-links">
      <a href="/" aria-current={Astro.url.pathname === "/" ? "page" : undefined}>Writing</a>
      {
        links.map((link) => (
          <a href={link.href} aria-current={Astro.url.pathname === link.href ? "page" : undefined}>
            {link.label}
          </a>
        ))
      }
    </div>
  </div>
</nav>
